<odoo>
    <record id="view_indent_request_form" model="ir.ui.view">
        <field name="name">Indent Request Form</field>
        <field name="model">indent.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Action Buttons -->
                    <button id="button_submit" name="action_submit" string="Submit" class="btn-primary" type="object"
                            invisible="state != 'draft'"/>

                    <button id="button_approve" name="action_approve" string="Approve" class="btn-success" type="object"
                            invisible="state != 'submit'"/>

                    <button id="button_refuse" name="action_refuse" string="Refuse" class="btn-danger" type="object"
                            invisible="state != 'submit'"/>

                    <button id="button_close" name="action_close" string="Close" class="btn-success" type="object"
                            invisible="state != 'submit'"/>

                    <button id="button_cancel" name="action_cancel" string="Cancel" class="btn-warning" type="object"
                            invisible="state not in ['draft', 'submit', 'refuse']"/>

                    <button id="button_draft" name="action_draft" string="Set to Draft" class="btn-secondary"
                            type="object"
                            invisible="state != 'cancel'"/>

                    <!-- Status Bar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submit,approve,refuse,close,cancel"/>
                </header>
                <sheet>
                    <div name="button_box" position="inside">
                        <button class="btn oe_stat_button btn-outline-secondary flex-grow-1 flex-lg-grow-0"
                                type="object"
                                name="action_view_picking"
                                icon="fa-truck">
                            <field string="Picking" name="internal_transfer_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h4 class="text-primary">
                            <field name="name" strign='Indent No' readonly="1"/>
                        </h4>
                        <br></br>
                    </div>
                    <group>
                        <group>
                            <field name="location_from"/>
                            <field name="location_to"/>
                            <field name="indent_date" readonly="1"/>
                            <field name="need_by"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="indent_by" readonly="1"/>
                            <field name="department" readonly="1"/>
                            <field name="approval_authority" readonly="1"/>
                            <field name="badge_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="item_ids">
                                <tree create="True" edit="True" delete="True" editable="bottom" class="tree_no_open">
                                    <field name="product_id"/>
                                    <field name="uom"/>
                                    <field name="current_stock"/>
                                    <field name="quantity"
                                           string="Quantity"
                                           readonly="parent.state == 'submit'"
                                           decoration-danger="quantity > approve_qty and parent.state not in ['done', 'cancel']"
                                           on_change="1"/>

                                    <field name="received_qty" readonly="1"/>
                                    <field name="approve_qty"
                                           string="Approve Qty"
                                           readonly="parent.state == 'approve'"
                                           decoration-danger="quantity > approve_qty and parent.state not in ['done', 'cancel']"
                                           on_change="1"/>
                                    <field name="remarks"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_indent_request_tree" model="ir.ui.view">
        <field name="name">Indent Request Tree</field>
        <field name="model">indent.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="indent_by"/>
                <field name="indent_date"/>
                <field name="department"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="indent_request_action">
        <field name="name">Indent Request</field>
        <field name="res_model">indent.request</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>